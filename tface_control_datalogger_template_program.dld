' T-FACE CR1000 Series Datalogger Program
' Creation date: 2018-06-01
' Last update: 2025-03-28 - JAM
' program authors:  Carl Bernacchi - primary
'                   Chris Montes - modifications
'                   Jesse McGrath - EKM Omnimeter metering code


'  This program will operate the T-FACE Experiment.

'  All IRRs will be read continuously and stored into separate files.

'  There are three files - one for T-FACE, one for raw variables, and one for the IRR parameters.

' SDM-CV04 C1 connected to C1 on CR3000, C2 to C2, C3 to C3
' Out1 to Dimmer 1.
' If additional reps are added in future, then Out2 to Dimmer 2, Out3 to Dimmer 3.
' Out4 to Dimmer 4. Additional SDM-CV04s can also be added.

' Note: The SDM-CV04 needs to be in Voltage Mode and the default as it comes from the
'       factory is Current Mode. Jumpers need to be changed to switch to voltage mode.
'       The first SDM-CV04 needs to have factory default address 0.
'       Another jumper also needs to be changed to set the address of a second
'       SDM-CV04 to be address 1.
'

' EKM Omnimeter 1 v.3 pin 14 connected to CR1000X pin P2
' EKM Omnimeter 1 v.3 pin 15 connected to CR1000X pin ground
' The Omnimeter sends 800 pulses per KWh

' Enter constants for the TFACE IRTs provided by Apogee.

' T-FACE Reference plot SN 1234
Const r_mC2 = 133757
Const r_mC1 = 11739300
Const r_mC0 = 2138210000
Const r_bC2 = 5021.86
Const r_bC1 = 366816
Const r_bC0 = -35064200
Const r_sn  = 1234

' T-FACE Heated plot SN 6184
Const h_mC2 = 66863.6
Const h_mC1 = 7707660
Const h_mC0 = 1377880000
Const h_bC2 = 7400.48
Const h_bC1 = 139180
Const h_bC0 = -3439490
Const h_sn  = 6184

' Site configuration constants.
Const rain_logger_id = "26164"   ' This is the station name for Athena
Const power_logger_id = "24242"  ' This is the station name for Aphrodite.
Const APHRODITE = "24242"        ' Independent of Aphrodite having the power logger, it has network issues, so keep track of that here.

' Below are constants for the control of the heater outputs.
Const two_pi = 6.283185
Const half_pi = 1.5708
Const SB = 5.67E-8
Const MODE = -1

#If LoggerType = CR1000X
  Const VoltRange = mV200C
  Const wind_pulse_port = P1
  Const ekm_meter_port = P2
  Const sw12_chan = SW12_1
#ElseIf LoggerType = CR1000
  Const VoltRange = mV2_5C
  Const wind_pulse_port = 1
  Const ekm_meter_port = 2
#EndIf

' Declare public variables
Public BattVolt, Pnl_Tmp
Public Wind
Public LoggerID as String * 20

' Temperature measurement variables
Public T_Diffrns
Public TadjH
Public mV_tpileR
Dim TbodyRK
Public TbodyRC
Dim TtarRK
Public TtarRC
Public mV_tpileH
Dim TbodyHK
Public TbodyHC
Dim TtarHK
Public TtarHC
Dim r_m, h_m, r_b, h_b

' Heater control & pid controller variables
Public Target = 2.5       ' degrees C. Temperature rise of heated plot above reference plot.
Public heatmanset         ' Manual control
Const delta_t = 5         ' seconds. delta_t must match the scan interval.
Public PID_heat_lmt
Public PID_heat_out
Public ScldOut(4)
Const Nmbr_Htrs = 24      ' Number heaters per SDM-CV04 output (1000 W Mor FTE)

Public heat_Kp = 47
Public heat_Ki = 0.15
Public heat_Kd = 95
Public heat_cons_m = 0.013
Public heat_cons_b = 4

Public heat_error_smooth = 0
Public heat_error_integral = 0
Public heat_error = NAN

Const heat_max_out_volt = 10      ' Physical hard maximum allowed voltage to control the heaters.
Const heat_min_out_volt = 0       ' Physical hard minimum allowed voltage to control the heaters.
Public heat_upper_lim = 10        ' Controller-restricted effective maximum voltage to control the heaters. Max is max_out_volt
Public heat_lower_lim = 0         ' Controller-restricted effective minimum voltage to control the heaters. Lowest is min_out_volt
Public heat_manual_max_volt = 10  ' A manually settable variable to limit the maximum voltage.

' Voltage limiter parameters
Public voltage_limiting_active As Boolean = True
Public volt_limit_out
Public clamp_lenience_interval = 0.1 ' volts

' VPD measurements variables
Dim e_s, e_a
Public ref_hygrovue(2)
Alias ref_hygrovue(1) = ref_VPD_RH
Alias ref_hygrovue(2) = ref_VPD_TC
Public ref_VPD

Public mist_hygrovue(2)
Alias mist_hygrovue(1) = mist_VPD_RH
Alias mist_hygrovue(2) = mist_VPD_TC
Public mist_VPD

' VPD control & pid controller variables
Public vpdmanset = 0
Public PID_vpd_lmt = 0

Public vpd_Kp = 47
Public vpd_Ki = 0.15
Public vpd_Kd = 95
Public vpd_cons_m = 0.013
Public vpd_cons_b = 4

Public vpd_error_smooth = 0
Public vpd_error_integral = 0
Public vpd_error = NAN
Public PID_vpd_out = 0

Const vpd_max_out_volt = 10      ' Physical hard maximum allowed voltage to control the pumps.
Const vpd_min_out_volt = 0       ' Physical hard minimum allowed voltage to control the pumps.
Public vpd_upper_lim = 10
Public vpd_lower_lim = 0
Public vpd_manual_max_volt = 10

' Power metering using EKM Omnimeter I v.3
Public ekmMeterPulseCount
Public ekmMeterKWh = nan
Public has_ekm_meter As Boolean

' Rain detector variables
Public is_raining As Boolean = True  ' Start with the assumption that it's raining, and in the first scan it will get the correct value.
Public is_rain_control As Boolean
Dim rain_byte_flag


' Define Data Tables
'  !!!!!!Note to change the name of all the files according to plot.
' This table is for all the heater array raw variables
DataTable (raw, True, -1)           ' Change based on plot
  DataInterval(0, 10, Min, -1)
  Sample (1, LoggerID, String)
  Average (1, TbodyRC, IEEE4, 0)
  Average (1, TbodyHC, IEEE4, 0)
  Average (1, mV_tpileR, IEEE4, 0)
  Average (1, mV_tpileH, IEEE4, 0)
  Average (1, TadjH, IEEE4, 0)
  Sample  (1, Target, IEEE4)
  Average (1, PID_heat_lmt, IEEE4, 0)
  Average (1, PID_vpd_lmt, IEEE4, 0)
  Average (1, ScldOut, IEEE4, 0)
  Average (1, Pnl_Tmp, IEEE4, 0)
  Sample (1, heatmanset, IEEE4)
  Average (1, is_raining, FP2, 0)
  Totalize (1, ekmMeterPulseCount, UINT4, 0)
  Sample (1, ekmMeterKWh, IEEE4)
  Sample (1, BattVolt, IEEE4)
EndTable

DataTable(irr_params, True, 75)
  Sample (1, LoggerID, String)
  Sample (1, r_mC2, IEEE4)
  Sample (1, r_mC1, IEEE4)
  Sample (1, r_mC0, IEEE4)
  Sample (1, r_bC2, IEEE4)
  Sample (1, r_bC1, IEEE4)
  Sample (1, r_bC0, IEEE4)
  Sample (1, r_sn,  UINT2)
  Sample (1, h_mC2, IEEE4)
  Sample (1, h_mC1, IEEE4)
  Sample (1, h_mC0, IEEE4)
  Sample (1, h_bC2, IEEE4)
  Sample (1, h_bC1, IEEE4)
  Sample (1, h_bC0, IEEE4)
  Sample (1, h_sn,  UINT2)
  FieldNames("LoggerID,r_mC2,r_mC1,r_mC0,r_bC2,r_bC1,r_bC0,r_sn,h_mC2,h_mC1,h_mC0,h_bC2,h_bC1,h_bC0,h_sn")
EndTable


'  This Table is for the T-FACE critical variables.
DataTable (control, True, -1)       ' Change based on plot
  DataInterval(0, 10, Min, -1)
  Sample (1, LoggerID, String)
  Average (1, TtarRC, IEEE4, 0)
  Average (1, TtarHC, IEEE4, 0)
  Average (1, TadjH, IEEE4, 0)
  Average (1, T_Diffrns, IEEE4, 0)
  Sample  (1, Target, IEEE4)
  Average (1, ScldOut, IEEE4, 0)
  Average (1, is_raining, IEEE4, 0)
  Sample  (1, heat_error_integral, IEEE4)
  Sample  (1, heat_error, IEEE4)
  Average (1, PID_heat_lmt, IEEE4, 0)
  Average (1, PID_heat_out, IEEE4, 0)
  Average (1, PID_vpd_lmt, IEEE4, 0)
  Average (1, PID_vpd_out, IEEE4, 0)
  Sample  (1, rateLimiterOn, IEEE4)
  Sample (1, heat_error_smooth, IEEE4)
  Sample (1, heat_upper_lim, IEEE4)
  Sample (1, volt_limit_out, IEEE4)
EndTable

Sub Clamp(x, lwr, upr)
  If x < lwr Then x = lwr
  If x > upr Then x = upr
EndSub

Function minimum(x, y)
  If x <= y Then
    Return x
  Else
    Return y
  EndIf
EndFunction

'  Subroutine to compute PID output control signal
'  Original version written with EDLOG by Tony Wahl from Campbell Scientific
'  Arguments passed to error_smooth, error_intergral and output are modified by this subroutine.
Sub PID_control(obs, set_point, Kp, Ki, Kd, upper_lim, lower_lim, cons_m, cons_b, error_smooth, error_integral, error, output)
  Public smoothing_time = 60  ' seconds
  Dim windup_upper_lim, windup_lower_lim, error_smooth_prev, error_deriv, PID_out
  Dim should_integrate As Boolean
  Public delta_integral
  Public PID_out
  Dim alpha
  Public rateLimiterOn = 0
  Dim potential_integral

  ' Error term
  error = obs - set_point

  ' Exponential weighted smoothing
  error_smooth_prev = error_smooth
  alpha = 1 - EXP(-delta_t / smoothing_time) ' sampling rate adjusted coefficient
  error_smooth = error * alpha + (1 - alpha) * error_smooth

  ' Derivative
  error_deriv = (error_smooth - error_smooth_prev) / delta_t  ' Backward finite difference.

  ' Integral
  delta_integral = Ki * delta_t / 2 * (error_smooth + error_smooth_prev)  ' Trapezoid rule; Ki is multiplied here.

  potential_integral = error_integral + delta_integral  ' Use a temporary integral so that we can check for windup later.

  PID_out = Kp * error_smooth + potential_integral + Kd * error_deriv
  PID_out = PID_out * MODE       ' Change sign according to +/- mode
  PID_out = PID_out * cons_m + cons_b

  ' Anti-windup. Only add to the integral when PID output isn't saturated.
  ' When checking saturation for windup, use a slightly permissive range. Otherwise it causes oscillations when near the extremes.
  windup_upper_lim = upper_lim + clamp_lenience_interval
  windup_lower_lim = lower_lim - clamp_lenience_interval

  should_integrate = (PID_out < windup_upper_lim AND PID_out > windup_lower_lim)  ' If the PID output is not saturated, add to the integral sum.
  should_integrate = should_integrate OR (PID_out >= windup_upper_lim AND delta_integral > 0)      ' Positive error means too hot, so if we're above the upper limit, we add only positive errors to the integral sum to cool down.
  should_integrate = should_integrate OR (PID_out <= windup_lower_lim AND delta_integral < 0)      ' Negative error means too cool, so if we're below the lower limit, we add only negative errors to the integral sum to heat up.

  If should_integrate Then
    error_integral = potential_integral
  EndIf


  output = PID_out
EndSub


'  Adjust the apparent temperature in the heated plot for radiation reflected
'  from the heaters.
Function CorrectRef(PID_CR, T_correct)
  Dim Eff, Maxrad, Th_Adjust, Radjust, Rheater, Rreflect, R_IRT

  ' Assume: fraction of thermal energy emitted by heater in the 8 to 14 um band
  '        sensed by Apogee IRR-P is 0.14 for heater at 600 degrees C.
  '        Multiply by 0.9 for window transmittance > 0.13.

  ' Assume: fraction of thermal energy emitted by canopy in the 8 to 14 um band
  '        sensed by Apogee IRR-P5 is 0.37 as per canopy at 20 degrees C.
  '        Multiply by 0.9 for window transmittance > 0.33.

  ' Assume: emissivity of plant canopy = 0.98
  Eff = 10 + 25 * EXP(-0.17 * Wind)  ' Compute efficiency of heater system (%) from wind (m/s)
  Maxrad = Nmbr_Htrs * 1000 * Eff / 100 / 7.07 ' Compute max down rad over 7.07 m^2 plot
  Rheater = Maxrad * (PID_CR / 10)^2 ' Scale in proportion to the square of the
                                     ' last value of PID control, so that have full
                                     ' correction when heaters fully on and no correction
                                     ' when heaters off.
  Rreflect = Rheater * (1 - 0.98) * 0.13              ' Calculate radiation from heater reflected by canopy
                                                      ' in 8-14 um band.
  R_IRT = 0.33 * SB * (T_correct + 273.15)^4          ' Calculate amount of energy sensed by IRT
  Radjust = R_IRT - Rreflect                          ' Subtract the radiation from the heater
  Th_Adjust = (Radjust / (SB * 0.33))^0.25 - 273.15 ' Calculate temperature from the radiation
  Return Th_Adjust
  ' Note: No adjustment for canopy emissivity and reflected sky radiation are being applied
  ' because it is assumed that these will be the same in the reference plot.
EndFunction


' The manufacturer says that full voltage can be applied to the ceramic
' elements from a cold start. However, ours fracture very frequently, maybe
' because they're outside where it's humid. As a precaution, we want to limit
' how quickly the applied current can increase; this will slow thermal
' expansion and hopefully reduce fracturing.

' max_volt_limit accepts the current control voltage (old_voltage) and returns
' an upper limit for a new voltage. It grows exponentially with old_voltage,
' allowing larger changes when the voltage is already high. It also keeps
' rudimentary track of how long they've been at high voltage, allowing larger
' changes when they've warmed up, which allows larger changes if the voltage
' decreased for only a few minutes, something that happens occasionally as the
' PID algorithm tries to regulate temperature.

Function max_volt_limit(old_voltage, max_out_volt)
    Dim voltageLimitRate
    Dim numerator
    Dim new_voltage
    Public unit_counter = 0
    Public curvature = 1.82
    Public allowed_rate_at_max_voltage = 0.45  ' Not the actual maximum. The actual allow rate is allowed_rate_at_max_voltage + minimum_allowed_rate.
    Public minimum_allowed_rate = 0.01         ' Not the actual minimum, but it moves the curve up and down, so it influences the minimum.
    Public build_up_time = 10                  ' minutes
    Public volt_bump = 0.5                     ' volts

    If old_voltage >= 3.5 AND unit_counter < 1 Then
        unit_counter += delta_t / 60 / build_up_time
    ElseIf unit_counter > 0 Then
        unit_counter -= delta_t / 60 / build_up_time
    EndIf

    If old_voltage < 1 Then
        new_voltage = 1 
    Else
        numerator = PWR(curvature, old_voltage - max_out_volt)
        voltageLimitRate = numerator / allowed_rate_at_max_voltage + minimum_allowed_rate
        new_voltage = old_voltage + voltageLimitRate + volt_bump * unit_counter
    EndIf

    Return new_voltage
EndFunction


' Different loggers use different commands for the 12 V switch.
' This is a wrapper so that every logger can be switched using the same
' function.
Sub switch_12_volt(state)
  #If LoggerType = CR1000X
    SW12(sw12_chan, state, 1)
  #ElseIf LoggerType = CR1000
    SW12(state)
  #EndIf
EndSub

'****************************************************************************************
' Main Program
BeginProg
  LoggerID = Status.StationName(1, 1)
  CallTable irr_params  ' Log the IRR parameters only once, at the start of the program.

  ' heatmanset allows manual control of the heater voltage.
  ' -1 lets the PID loop control the heaters.
  ' Values from 0-10 set the control voltage output to the dimmer.
  heatmanset = 0
  vpdmanset = 0
  PID_heat_lmt = 0  ' Turn off initially.
  PID_vpd_lmt = 0   ' Turn off initially.


  Call switch_12_volt(True)

  is_rain_control = (LoggerID = rain_logger_id)
  If LoggerID = power_logger_id Then
    has_ekm_meter = True
  EndIf

  PulseCountReset  ' This resets all pulse counts.  Not sure if it's needed, but whatever.

  Scan(delta_t, Sec, 0, 0)

    PanelTemp (Pnl_Tmp, _60Hz) ' This is the data logger temperature
    Battery (BattVolt)         ' This tells us the voltage of the battery powering the data logger.
    PulseCount (Wind, 1, wind_pulse_port, 0, 1, 0.09462, 0.2) ' This is for an optional wind speed sensor, which
                                                ' can be used to determine heater efficiency.
    If Wind = NAN Then
        Wind = 0.2
    EndIf

    ' =====================================================
    ' Temperature calculations
    ' This section will collect the IRR measurements from the T-FACE IRRs (both ref and heated).
    ' =====================================================

    ' Measure thermopile voltages of T-FACE Reference IRTs
    VoltDiff(mV_tpileR, 1, VoltRange, 1, True , 0, _60Hz, 1.0, 0) ' Diff channel 1
    ' Measure ratios Vx/Vb of body thermistors of Reference IRTs
    Therm109(TbodyRC, 1, 5, Vx1, 0, _60Hz, 1.0, 0) ' SE channel 5

    ' Calculation of m (slope) and b (intercept) coefficients for target temperature calculation
    r_m = r_mC2 * TbodyRC^2 + r_mC1 * TbodyRC + r_mC0
    r_b = r_bC2 * TbodyRC^2 + r_bC1 * TbodyRC + r_bC0

    ' Calculation of target temperature
    TbodyRK = TbodyRC + 273.15
    TtarRK = (TbodyRK^4 + r_m * mV_tpileR + r_b)^0.25
    TtarRC = TtarRK - 273.15

    ' For Heated Plots
    ' Measure thermopile voltages of T-FACE Heated IRTs
    VoltDiff (mV_tpileH, 1, VoltRange, 2, True , 0, _60Hz, 1.0, 0)
    ' Measure ratios Vx/Vb of body thermistors of Heated IRTs
    Therm109 (TbodyHC, 1, 6, Vx1, 0, _60Hz, 1.0, 0)
    ' Calculation of m (slope) and b (intercept) coefficients for target temperature calculation
    h_m = h_mC2 * TbodyHC^2 + h_mC1 * TbodyHC + h_mC0
    h_b = h_bC2 * TbodyHC^2 + h_bC1 * TbodyHC + h_bC0

    ' Calculation of target temperature
    TbodyHK = TbodyHC + 273.15
    TtarHK = (TbodyHK^4 + h_m * mV_tpileH + h_b)^0.25
    TtarHC = TtarHK - 273.15

    '*******************************************************
    ' Do an adjustment of the temperature in the heated plot for thermal radiation
    ' from the heaters that is reflected from the crop canopy to the IRT

    TadjH = CorrectRef(PID_heat_lmt, TtarHC)

    ' Compute temperature difference between heated and control plots
    T_Diffrns = TadjH - TtarRC
    heat_upper_lim = minimum(heat_max_out_volt, heat_manual_max_volt)
    volt_limit_out = max_volt_limit(PID_heat_lmt, heat_max_out_volt)

    If voltage_limiting_active Then
      heat_upper_lim = minimum(heat_upper_lim, volt_limit_out)
    EndIf

    If TtarHC > 42 OR is_raining OR (T_Diffrns > Target + 2) Then
      heat_upper_lim = minimum(heat_upper_lim, 3.5)
    EndIf

    If heatmanset < 0 Then
      ' Set maximum temperature in the heated plot - presently same threshold for both experiments.
      PID_control(T_Diffrns, Target, heat_Kp, heat_Ki, heat_Kd, heat_upper_lim, heat_lower_lim, heat_cons_m, heat_cons_b, heat_error_smooth, heat_error_integral, heat_error, PID_heat_out)
      PID_heat_lmt = PID_heat_out
    Else
      ' MANUAL OVERRIDE
      PID_heat_lmt = heatmanset
      PID_heat_out = NAN
    EndIf

    ' Apply max delta voltage, rain limit, etc.
    Call Clamp(PID_heat_lmt, heat_lower_lim, heat_upper_lim)
    Call Clamp(PID_heat_lmt, heat_min_out_volt, heat_max_out_volt)

    If (PID_heat_lmt = NAN) Then
        ' If one of the sensors gave NAN, PID_heat_lmt will be NAN. Set it to 0 to ensure sensible behavior in SDMCV04.
        PID_heat_lmt = 0
    EndIf

    ' =====================================================
    ' VPD calculations
    ' =====================================================

    SDI12Recorder(ref_hygrovue(), C5, "0", "M!", 1, 0)  ' The aliases ref_VPD_RH and ref_VPD_TC are set here.
    'e_s = 0.61078 * EXP(17.27 * ref_VPD_TC / (ref_VPD_TC + 237.3))  ' Tetens equation to calculate saturation vapor pressure.
    SatVP(e_s, ref_VPD_TC)
    e_a = e_s * ref_VPD_RH / 100
    ref_VPD = e_s - e_a

    SDI12Recorder(mist_hygrovue(), C5, "1", "M!", 1, 0)  ' The alias mist_VPD_RH and mist_VPD_TC are set here.
    'e_s = 0.61078 * EXP(17.27 * mist_VPD_TC / (mist_VPD_TC + 237.3))  ' Tetens equation to calculate saturation vapor pressure.
    SatVP(e_s, mist_VPD_TC)
    e_a = e_s * mist_VPD_RH / 100
    mist_VPD = e_s - e_a

    If vpdmanset < 0 Then
      PID_control(mist_VPD, ref_VPD, vpd_Kp, vpd_Ki, vpd_Kd, vpd_upper_lim, vpd_lower_lim, vpd_cons_m, vpd_cons_b, vpd_error_smooth, vpd_error_integral, vpd_error, PID_vpd_out)
      PID_vpd_lmt = PID_vpd_out
    Else
      PID_vpd_lmt = vpdmanset
      PID_vpd_out = NAN
    EndIf

    Call Clamp(PID_vpd_lmt, vpd_lower_lim, vpd_upper_lim)
    Call Clamp(PID_vpd_lmt, vpd_min_out_volt, vpd_max_out_volt)

    If PID_vpd_lmt = NAN Then
      PID_vpd_lmt = 0
    EndIf

    ' =====================================================
    ' Outputs
    ' =====================================================

    ScldOut(1) = PID_heat_lmt * 1000
    ScldOut(2) = PID_vpd_lmt * 1000
    ScldOut(3) = 0
    ScldOut(4) = 0

    '***********************************************************
    SDMCVO4 (ScldOut(), 4, 0, 10)  ' Send instruction to SDM-CV04s (mV, reps, SDMaddress, volts).
    '**********************************************************

    ' Rain sensing
    If is_rain_control Then
      ReadIO(rain_byte_flag, 8)  ' byte flag. This checks if there is a 5 V signal coming into C4. The value returned by ReadIO is a byte flag, and the fourth bit is one (decimal value of 8) if C4 is high.
      is_raining = ((rain_byte_flag AND 8) <> 0)  ' True or False. If that bit is high, it's raining.
    EndIf

    ' Power meter
    ' I know the conversion can be done in one step with PulseCount() but want both the count and the conversion.
    PulseCount(ekmMeterPulseCount, 1, ekm_meter_port, 1, 0, 1, 0)
    If has_ekm_meter Then
      ekmMeterKWh = ekmMeterPulseCount / 800
    EndIf

    CallTable raw      ' Change based on plot
    CallTable control  ' Change based on plot
  NextScan

  SlowSequence
    Scan(2, hr, 0, 0)
      ' The loggers often lose network connections and the wireless hardware needs to be restarted.
      ' This code restarts the 12 V connection that powers the wireless controller,
      ' only for Aphrodite, and only from 5 am to 8 pm.

      If (LoggerID = APHRODITE) AND TimeIsBetween(5, 20, 24, Hr) Then
        Call switch_12_volt(False)
        Delay(1, 10, sec)
        Call switch_12_volt(True)
      EndIf
    NextScan
  EndSequence
EndProg
